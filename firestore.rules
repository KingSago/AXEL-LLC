rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-user app: only Axel's authenticated account may read or write
    // anything. Replace AXELS_UID with the real Firebase Auth UID after his
    // user is created (Authentication > Users in the Firebase console).
    //
    // The Stripe webhook writes via the Admin SDK, which bypasses these rules
    // server-side, so billing updates are unaffected by this lockdown.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid in ["5wmmsTAofWcr06hlWpSpC3mIaQv1",
                                                  "q80D95XwCNSIu5E001lC631LRWI3",
                                                  "oFaClJlAgtXAnetHIf2ECWPCulf2"];
    }
  }
}
