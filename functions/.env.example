# Copy to functions/.env and fill in. These are NON-secret params.
# (Secrets STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set separately via
#  `firebase functions:secrets:set`, NOT here.)

# Public base URL of the deployed tracker app (used for Stripe redirect URLs).
# Local emulator example:
APP_BASE_URL=http://localhost:5000
# Production example:
# APP_BASE_URL=https://your-project.web.app

# Optional: lock callable functions to Axel's Firebase Auth UID.
# Leave blank to allow any authenticated user (sign-up is disabled, so only Axel exists).
ALLOWED_UID=
